# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev fallback for lib/storage.ts when Spaces creds aren't set -
# served via app/api/uploads/[...path]/route.ts, not public/ static serving
/.local-uploads/

# Playwright E2E - generated output, not source
/e2e-report/
/test-results/
/e2e/screenshots/*.png
/playwright-report/
/.playwright-mcp/
